# Local-only example. Copy to .dev.vars and replace every placeholder.
PASSPHRASE=replace_with_website_passcode
DEV_PASSPHRASE=replace_with_developer_passphrase
DEV_TOKEN_SECRET=replace_with_a_long_random_secret
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret_key
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-service-account@your-firebase-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_private_key_contents\n-----END PRIVATE KEY-----\n"
HYPERBEAM_API_KEY=replace_with_hyperbeam_api_key

# PASSWORD_RATE_LIMITER is a Cloudflare binding, not an environment variable.
