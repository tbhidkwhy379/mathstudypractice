{
  "rules": {
    "classroomspot-chat": {
      "messages": {
        ".read": "auth != null",
        "$messageId": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.hasChildren(['uid', 'name', 'ts']) && ((newData.child('text').isString() && newData.child('text').val().length > 0) || newData.hasChild('imageUrl'))",
          "uid": {
            ".validate": "newData.isString() && newData.val() == auth.uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "imageUrl": {
            ".validate": "newData.isString() && newData.val().length <= 7000000"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "users": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['uid', 'name'])",
          "uid": {
            ".validate": "newData.isString() && newData.val() == $uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "isAnonymous": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "friends": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          "$friendUid": {
            ".write": "auth != null && auth.uid == $uid && (root.child('classroomspot-chat/friendRequests/' + $uid + '/' + $friendUid).exists() || root.child('classroomspot-chat/friendRequests/' + $friendUid + '/' + $uid + '/accepted').val() == true)",
            ".validate": "newData.val() == true"
          }
        }
      },
      "friendRequests": {
        "$toUid": {
          ".read": "auth != null && auth.uid == $toUid",
          "$fromUid": {
            ".read": "auth != null && (auth.uid == $toUid || auth.uid == $fromUid)",
            ".write": "auth != null && ((auth.uid == $fromUid && !data.exists() && !newData.child('accepted').exists() && !newData.child('ignored').exists()) || (auth.uid == $toUid && data.exists() && newData.exists() && newData.child('uid').val() == $fromUid && newData.child('name').val() == data.child('name').val() && newData.child('ts').val() == data.child('ts').val() && ((newData.child('accepted').val() == true && !newData.child('ignored').exists()) || (newData.child('ignored').val() == true && !newData.child('accepted').exists()))))",
            ".validate": "newData.hasChildren(['uid', 'name', 'ts'])",
            "uid": {
              ".validate": "newData.isString() && newData.val() == $fromUid"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
            },
            "ts": {
              ".validate": "newData.isNumber()"
            },
            "accepted": {
              ".validate": "newData.isBoolean()"
            },
            "ignored": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "directMessages": {
        "$uid1": {
          "$uid2": {
            ".read": "auth != null && (auth.uid == $uid1 || auth.uid == $uid2) && (root.child('classroomspot-chat/friends/' + $uid1 + '/' + $uid2).val() == true || root.child('classroomspot-chat/friends/' + $uid2 + '/' + $uid1).val() == true)",
            "messages": {
              "$messageId": {
                ".write": "auth != null && (auth.uid == $uid1 || auth.uid == $uid2) && (root.child('classroomspot-chat/friends/' + $uid1 + '/' + $uid2).val() == true || root.child('classroomspot-chat/friends/' + $uid2 + '/' + $uid1).val() == true) && !data.exists()",
                ".validate": "newData.hasChildren(['uid', 'name', 'ts']) && ((newData.child('text').isString() && newData.child('text').val().length > 0) || newData.hasChild('imageUrl'))",
                "uid": {
                  ".validate": "newData.isString() && newData.val() == auth.uid"
                },
                "name": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
                },
                "text": {
                  ".validate": "newData.isString() && newData.val().length <= 1000"
                },
                "ts": {
                  ".validate": "newData.isNumber()"
                },
                "imageUrl": {
                  ".validate": "newData.isString() && newData.val().length <= 7000000"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          }
        }
      },
      "aiChats": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid",
          "$chatId": {
            ".validate": "newData.hasChildren(['title', 'createdAt', 'updatedAt', 'charCount'])",
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "charCount": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50000"
            },
            "messages": {
              "$messageId": {
                ".validate": "newData.hasChildren(['role', 'text', 'ts'])",
                "role": {
                  ".validate": "newData.val() == 'user' || newData.val() == 'assistant'"
                },
                "text": {
                  ".validate": "newData.isString() && newData.val().length <= 50000"
                },
                "ts": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
